# =============================================================================
# L'ÉTOILE LUXURY UNISEX HAIR SALON & SPA
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust credentials as required.
# =============================================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Hair%20salon%20and%20spa
APP_TIMEZONE=America/New_York

# Demo Mode: true | false (Isolated in-memory session mode, zero database required)
DEMO_MODE=false

# MySQL Database Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=letoile_salon_db
DB_USER=root
DB_PASS=root

# Concierge Settings
CONCIERGE_SALON_NAME="L'Étoile Luxury Unisex Hair Salon & Spa"
CONCIERGE_EMAIL=concierge@letoile-salon-placeholder.com
CONCIERGE_PHONE="+1 (800) 555-0192"
